# ==============================================================================
# Dev Dialogue — Monorepo Environment Variables Template (.env.example)
#
# Copy this file to '.env' in this root directory:
#   cp .env.example .env
#
# Both Next.js (apps/web) and ASP.NET Core (apps/api) read from this root .env!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Authentication & Client Configuration
# ------------------------------------------------------------------------------
# Where to find these in Supabase:
#   1. Go to https://supabase.com/dashboard/project/<your-project-id>
#   2. Click "Project Settings" (gear icon in left sidebar) -> "API"
#   3. Under "Project URL", copy the URL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

#   4. Under "Project API keys", copy the "anon public" key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

#   5. Under "JWT Settings", copy the "JWT Secret":
#   (Used by apps/api to verify Supabase login tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# ------------------------------------------------------------------------------
# 2. Database Connection String (PostgreSQL)
# ------------------------------------------------------------------------------
# Where to find this in Supabase:
#   1. Supabase Dashboard -> "Project Settings" -> "Database"
#   2. Scroll down to "Connection parameters" or "Connection string" (URI or ADO.NET)
#   3. Use Port 6543 (Transaction pooler) or 5432 (Session mode)
# If left empty, apps/api automatically runs on an in-memory database for testing!
CONNECTION_STRING=Host=aws-0-eu-central-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project;Password=your-database-password

# ------------------------------------------------------------------------------
# 3. Local Backend API Address (used by Frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5238

# ------------------------------------------------------------------------------
# 4. AI Provider Configuration
# ------------------------------------------------------------------------------
# Options: 'Mock' (zero cost, realistic offline responses) or 'Cloud' (Groq/OpenRouter)
AI_PROVIDER=Mock
AI_BASE_URL=https://api.groq.com/openai/v1
# If AI_PROVIDER=Cloud, get your free key from https://console.groq.com/keys:
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 5. Business Logic & Limits
# ------------------------------------------------------------------------------
DAILY_INTERVIEW_LIMIT=10
