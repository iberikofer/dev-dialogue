# ==========================================
# Dev Dialogue — Environment Variables Template
# ==========================================

# Supabase Auth & PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# Database Connection (Supabase PostgreSQL or Local Docker)
CONNECTION_STRING=Host=aws-0-eu-central-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project;Password=your-password

# Backend API URL (Frontend requests)
NEXT_PUBLIC_API_URL=http://localhost:5000

# AI Provider Configuration
# Set AI_PROVIDER to 'Mock' for zero-cost offline development, or 'Cloud' for Groq/OpenRouter
AI_PROVIDER=Mock
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.1-8b-instant

# Daily Quota Settings
DAILY_INTERVIEW_LIMIT=10
